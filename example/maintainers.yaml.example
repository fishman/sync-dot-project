# Maintainer roster. Copy to maintainers.yaml and fill in.
# project-maintainers is CNCF metadata (not written to OWNERS); every other
# team name becomes an OWNERS section of the same name.

maintainers:
  - project_id: "repo-a"
    org: "my-org"
    teams:
      - name: "project-maintainers"
        members:
          - alice
      - name: "approvers"
        members:
          - alice
      - name: "reviewers"
        members:
          - bob
